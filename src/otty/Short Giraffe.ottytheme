# Generated by Short Giraffe — do not edit by hand
# Source: src/otty/theme.ts + src/palette.ts

[meta]
name        = "Short Giraffe"
author      = "kumamaki"
mode        = "dark"
description = "Minimalistic dark theme with playful coral accents"

[terminal]
foreground           = "#cbccc6"
background           = "#191F2B"
cursor               = "#F29E74"
cursor-text          = "#191F2B"
selection-foreground = "#F7F7E5"
selection-background = "#2a3546"
palette = [
  "#191e2a", "#ed8274", "#a6cc70", "#fad07b",
  "#6dcbfa", "#cfbafa", "#90e1c6", "#c7c7c7",
  "#686868", "#f28779", "#bae67e", "#ffd580",
  "#73d0ff", "#d4bfff", "#95e6cb", "#ffffff",
]

[selection]
foreground = "#F7F7E5"
background = "#2a3546"

[cursor]
color = "#F29E74"
text  = "#191F2B"

[ghost]
foreground = "#686868"

[token]
foreground = "#cbccc6"
secondary  = "#CAD0DC"
tertiary   = "#707a8c"
accent     = "#F29E74"
success    = "#a6cc70"
warning    = "#fad07b"
danger     = "#ed8274"
hover-bg   = "rgba(255,255,255,0.05)"
active-bg  = "rgba(242,158,116,0.18)"
radius     = 6
shadow     = "0 8px 24px rgba(0,0,0,0.35)"
font-ui    = ["-apple-system", "BlinkMacSystemFont", "SF Pro", "sans-serif"]
font-mono  = ["JetBrains Mono", "SF Mono", "Menlo", "monospace"]
font-size  = 13

[panel]
background = "#151b25"
surface    = "#222833"
border     = "rgba(48,55,67,0.35)"

[window]
background = "#191F2B"
material   = "none"
radius     = 12

[window.unfocused]
opacity = 0.92

[titlebar]
foreground  = "#cbccc6"
font-size   = 13
font-weight = 500
height      = 40

[titlebar.unfocused]
foreground = "#707a8c"

[sidebar]
background   = "#151b25"
border-right = "1px solid #0F131A"
width        = 220
material     = "none"

[tab]
background  = "transparent"
foreground  = "#707a8c"
radius      = 6
font-size   = 13
font-weight = 400
padding     = 10
indicator-color = "#707a8c"

[tab.hover]
background = "rgba(255,255,255,0.05)"

[tab.active]
background  = "#222833"
foreground  = "#F29E74"
font-weight = 500
shadow      = "0 1px 2px rgba(0,0,0,0.25)"
indicator-color = "#F29E74"

[tab.active.unfocused]
background = "#222833"
foreground = "#707a8c"
shadow     = "none"

[tab-bar]
height        = 36
padding       = 8
border-bottom = "1px solid rgba(48,55,67,0.35)"

[tab-bar.tab]
radius = 8
height = 28

[container]
background = "#191F2B"
radius     = 0
margin     = 0
padding    = 8

[divider]
color = "rgba(15,19,26,0.55)"
width = 1
